rules_version = '2';

// Модель доступа: анонимный Firebase Auth + членство в семье.
//  1. Пользователь ничего не вводит: при старте клиент выполняет
//     signInAnonymously() и получает auth.uid.
//  2. Членство — это документ families/{familyId}/members/{auth.uid}.
//     Он же определяет роль (owner/editor/viewer) и статус (active/removed).
//  3. Первого участника (владельца) создаёт сам клиент при создании семьи;
//     остальные могут создать документ только по действующему коду
//     приглашения (inviteCodes/{code}).
//  4. Премиум-статус (families/*.premium) меняют ТОЛЬКО Cloud Functions
//     через Admin SDK: клиент не может выдать себе Premium.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    // Членство определяется документом участника, а не массивом в семье:
    // так вход по коду не требует правки документа семьи (её меняет владелец).
    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function isOwner(familyId) {
      return isMember(familyId)
        && familyDoc(familyId).ownerAuthUid == request.auth.uid;
    }

    // Код действителен, если существует, не отозван и не истёк.
    function inviteIsValid(familyId, code) {
      return code is string
        && code.size() == 8
        && exists(/databases/$(database)/documents/inviteCodes/$(code))
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.familyId == familyId
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.revoked == false
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.expiresAt > request.time.toMillis();
    }

    // Клиент пишет время как int (миллисекунды). Разрешаем небольшое
    // расхождение с серверным временем, но не произвольные даты.
    function freshTimestamp() {
      return request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.time.toMillis() - 300000
        && request.resource.data.updatedAt <= request.time.toMillis() + 300000;
    }

    // Клиент не может менять поля, которые принадлежат серверу:
    // premium, memberIds/memberUids, ownerUserId, revision, schemaVersion.
    function serverOnlyFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'premium', 'memberIds', 'memberUids', 'ownerUserId', 'ownerAuthUid', 'schemaVersion'
      ]);
    }

    // Документ пользователя: ключ — auth.uid, поэтому владелец совпадает
    // с путём документа.
    match /users/{authUid} {
      allow read, write: if signedIn() && request.auth.uid == authUid;
    }

    // Семья: читают участники, создаёт владелец, правит владелец.
    // Клиент может менять только «шапку» (name, settings, updatedAt, revision).
    match /families/{familyId} {
      allow read: if isMember(familyId);

      allow create: if signedIn()
        && request.resource.data.ownerAuthUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.premium.active == false;

      allow update: if isOwner(familyId) && serverOnlyFieldsUntouched();

      // Удаление семьи — только владелец. Клиент стирает файлы Storage,
      // содержимое и участников до этого шага (см. FamilyCleanupService).
      allow delete: if isOwner(familyId);
    }

    // Участники семьи: документ ключуется по auth.uid (по нему же проверяют
    // доступ Storage Rules). Владелец добавляет себя при создании семьи,
    // остальные — только по действующему коду приглашения.
    match /families/{familyId}/members/{memberUid} {
      allow read: if isMember(familyId);

      allow create: if signedIn()
        && request.auth.uid == memberUid
        && request.resource.data.authUid == memberUid
        && request.resource.data.userId is string
        && freshTimestamp()
        && (
             familyDoc(familyId).ownerAuthUid == request.auth.uid
             || inviteIsValid(familyId, request.resource.data.inviteCode)
           );

      allow update: if isOwner(familyId);

      // Выход из семьи: участник может удалить свой документ, но не чужой.
      // Порядок ветвей важен: к моменту самоудаления документ семьи уже может
      // быть удалён, и `isOwner` вернул бы ошибку (exists проверяет это).
      allow delete: if request.auth.uid == memberUid
        || (
             exists(/databases/$(database)/documents/families/$(familyId))
             && isOwner(familyId)
           );
    }

    // Содержимое семьи: people, events, media, audit.
    match /families/{familyId}/{collection}/{document} {
      allow read: if isMember(familyId);

      allow create, update: if isMember(familyId) && freshTimestamp();

      allow delete: if isOwner(familyId);
    }

    // Коды приглашений: читать может любой авторизованный (нужно для входа),
    // создаёт только владелец семьи, изменить — только Cloud Function.
    // Удалять может автор кода или владелец семьи (нужно при удалении данных).
    match /inviteCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdByAuthUid == request.auth.uid
        && isOwner(request.resource.data.familyId);

      allow update: if false;

      allow delete: if signedIn()
        && (
             request.auth.uid == resource.data.createdByAuthUid
             || isOwner(resource.data.familyId)
           );
    }

    // Реестр платежей и сессии Telegram: пишет только сервер.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /telegramSessions/{sessionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Публичная конфигурация (цены, минимальная версия приложения).
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
